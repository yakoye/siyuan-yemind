{
  "name": "siyuan-yemind",
  "version": "1.9.9-rc.7",
  "private": true,
  "description": "A SiYuan mind-map plugin built around simple-mind-map.",
  "license": "MIT",
  "scripts": {
    "generate:theme-colors": "node scripts/generate-theme-color-data.mjs",
    "predev": "npm run generate:theme-colors",
    "dev": "vite build --watch --mode development",
    "dev:web": "vite --config vite.web.config.ts",
    "prebuild": "npm run generate:theme-colors && npm run check:version",
    "build": "vite build && node scripts/copy-build.mjs",
    "build:all": "npm run build && npm run build:web",
    "prebuild:web": "npm run check:version",
    "build:web": "vite build --config vite.web.config.ts && node scripts/copy-web-assets.mjs",
    "precheck": "npm run generate:theme-colors",
    "check": "tsc --noEmit && npm run check:docs",
    "check:docs": "node scripts/docs/checkDocumentation.mjs",
    "check:version": "node scripts/check-version.mjs",
    "pretest": "npm run generate:theme-colors",
    "test": "node scripts/check-test-structure.mjs && vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "pretest:watch": "npm run generate:theme-colors",
    "test:watch": "vitest",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:e2e": "playwright test",
    "version:set": "node scripts/release/set-version.mjs",
    "release:build": "npm run build:all && node scripts/release/build-release.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "test:structure": "node scripts/check-test-structure.mjs",
    "test:syntax": "node scripts/check-typescript-syntax.mjs",
    "test:offline": "node scripts/run-offline-smokes.mjs",
    "verify:assets": "node scripts/verify-yemind-assets.mjs",
    "sync:runtime": "node scripts/sync-runtime.mjs --target D:\\myDatabase\\SiYuan\\data\\plugins\\siyuan-yemind",
    "sync:runtime:in-place": "node scripts/sync-runtime.mjs --in-place --target D:\\myDatabase\\SiYuan\\data\\plugins\\siyuan-yemind"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "parchment": "^3.0.0",
    "quill": "^2.0.3",
    "quill-delta": "^5.1.0",
    "simple-mind-map": "file:vendor/simple-mind-map-runtime"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
